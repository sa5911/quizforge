{
  "name": "quizforge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "npx -y firebase-tools@13 emulators:start --only auth,firestore --project sabirquizapp --import=./emulator-data --export-on-exit=./emulator-data",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test": "node --test test/api.test.js",
    "test:emulated": "npx -y firebase-tools@13 emulators:exec --only auth,firestore --project demo-quizforge \"npm test\"",
    "seed:data": "node scripts/seed-data.mjs",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "^16.3.5",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
